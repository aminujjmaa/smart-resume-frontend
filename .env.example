# frontend/.env.example — copy to .env.local for development.
# NEXT_PUBLIC_* values are inlined at build time (pass them as Docker build args).

# API base URL. In production point browsers straight at the API host so the
# backend sees real client IPs (rate limits), e.g. https://api.smartresume.co.in/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Where the Next.js /api/* rewrite proxies to (dev convenience)
BACKEND_URL=http://localhost:8000

# Canonical site URL used for metadata, sitemap and share links
NEXT_PUBLIC_SITE_URL=https://smartresume.co.in

# Razorpay public key id (test or live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
